[mysqld]
# Configuration de base pour l'environnement Docker
# Augmenter la taille du buffer pour améliorer les performances des requêtes
innodb_buffer_pool_size = 256M 
# Taille maximale des requêtes HTTP (utile pour les importations)
max_allowed_packet = 16M 
# Journalisation des requêtes lentes pour le monitoring
long_query_time = 1
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/mysql-slow.log

# Sécurité : Limiter le nombre de connexions échouées
max_connect_errors = 100